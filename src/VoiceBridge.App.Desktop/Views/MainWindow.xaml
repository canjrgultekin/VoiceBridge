<Window x:Class="VoiceBridge.App.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VoiceBridge.App.Desktop.ViewModels"
        Title="VoiceBridge — Real-Time Translation"
        Height="800" Width="1100"
        MinHeight="600" MinWidth="800"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌉" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="VoiceBridge" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Real-Time Translation" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,2"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionState}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="3" Content="⚙️" FontSize="18"
                        Command="{Binding OpenSettingsCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        VerticalAlignment="Center" Padding="8,4"
                        ToolTip="Ayarlar"/>
            </Grid>
        </Border>

        <!-- Controls Bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="0,1,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Microphone Selection -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="🎤" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding MicrophoneDevices}"
                              SelectedItem="{Binding SelectedMicrophone}"
                              DisplayMemberPath="Name" Width="250"
                              IsEnabled="{Binding IsSessionActive, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>

                <!-- Source Type -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="📡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding SourceTypeOptions}"
                              SelectedItem="{Binding SelectedSourceType}"
                              DisplayMemberPath="DisplayName" Width="160"
                              IsEnabled="{Binding IsSessionActive, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>

                <!-- VU Meter (mic level) -->
                <Grid Grid.Column="2" Margin="8,0,16,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📊" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Grid Grid.Column="1" Height="14" MaxWidth="220">
                        <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="3"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding MicLevel, Mode=OneWay}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource SuccessBrush}"
                                     Margin="1"/>
                        <!-- Peak hold indicator -->
                        <Rectangle Width="2" Height="14" Fill="#FFD166"
                                   HorizontalAlignment="Left" VerticalAlignment="Stretch">
                            <Rectangle.RenderTransform>
                                <TranslateTransform X="{Binding MicLevelPeak, Mode=OneWay}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Grid>

                <!-- Session Stats -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="⏱" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding SessionDuration}" FontSize="13" FontFamily="Consolas"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="👥" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding SpeakerCount}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="💬" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding EntryCount}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Start/Stop -->
                <Button Grid.Column="4" Content="▶  Başlat"
                        Command="{Binding StartSessionCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <Button Grid.Column="5" Content="⏹  Durdur"
                        Command="{Binding StopSessionCommand}"
                        Style="{StaticResource DangerButton}"/>
            </Grid>
        </Border>

        <!-- Transcript Area -->
        <Border Grid.Row="2" Margin="16,16,16,8">
            <ListView ItemsSource="{Binding Entries}"
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="False"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      x:Name="TranscriptList">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TranscriptEntryViewModel}">
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="10" Padding="16,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInterim}" Value="True">
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Speaker Info Row -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Background="{StaticResource SurfaceLightBrush}"
                                                CornerRadius="4" Padding="8,3">
                                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding SpeakerLabel}"/>
                                        </Border>
                                        <TextBlock Text="{Binding LanguageFlag}" FontSize="16"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Timestamp}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="⏳" FontSize="11" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsTranslationPending,
                                                       Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Per-entry copy button -->
                                    <Button Grid.Column="1" Content="📋"
                                            Command="{Binding CopyEntryCommand}"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" FontSize="13" Padding="6,2"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            ToolTip="Bu kaydı panoya kopyala"/>
                                </Grid>

                                <!-- Original Text -->
                                <TextBlock Grid.Row="1" Text="{Binding OriginalText}"
                                           FontSize="15" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,4"/>

                                <!-- Translated Text -->
                                <TextBlock Grid.Row="2" FontSize="14" TextWrapping="Wrap"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{Binding TranslatedText,
                                               Converter={StaticResource StringToVisibilityConverter}}">
                                    <Run Text="→ "/><Run Text="{Binding TranslatedText, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="🗑 Temizle"
                        Command="{Binding ClearTranscriptCommand}"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="12" Padding="12,6" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="📋 Kopyala"
                        Command="{Binding CopyAllCommand}"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="12" Padding="12,6" Margin="0,0,8,0"
                        ToolTip="Tüm transkripti panoya kopyala"/>
                <Button Grid.Column="3" Content="💾 TXT"
                        Command="{Binding ExportAsTextCommand}"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="12" Padding="12,6" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="🎬 SRT"
                        Command="{Binding ExportAsSrtCommand}"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="12" Padding="12,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
