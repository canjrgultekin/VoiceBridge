{
  "VoiceBridge": {
    "Deepgram": {
      "ApiKey": "",
      "Model": "nova-3",
      "Language": "tr-en",
      "Diarize": true,
      "SmartFormat": true,
      "Punctuate": true,
      "SampleRate": 16000,
      "Encoding": "linear16",
      "Channels": 1,
      "InterimResults": true,
      "UtteranceEnd": true,
      "UtteranceEndMs": 1000
    },
    "DeepL": {
      "ApiKey": "",
      "ModelType": "latency_optimized",
      "Formality": "default"
    },
    "Audio": {
      "SampleRate": 16000,
      "BitsPerSample": 16,
      "ChannelCount": 1,
      "BufferMs": 20
    },
    "Translation": {
      "AutoTranslate": true,
      "BatchDelayMs": 100,
      "MaxBatchSize": 5
    },
    "AudioFiltering": {
      "EnableVad": true,
      "VadThreshold": 0.5,
      "VadHangoverMs": 400,
      "EnableNoiseGate": true,
      "NoiseGateDbfs": -45.0,
      "MinWordCount": 2
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
